# Support GKI mixed build
ifeq ($(DEVICE_MODULES_PATH),)
DEVICE_MODULES_PATH = $(srctree)
else
LINUXINCLUDE := $(DEVCIE_MODULES_INCLUDE) $(LINUXINCLUDE)
endif

KO_HYPER_CODE_PATH := $(if $(filter /%,$(src)),,$(srctree)/)$(src)
KO_HYPER_INCLUDE_PATH := $(KO_HYPER_CODE_PATH)/include

$(info DEVICE_MODULES_PATH=$(DEVICE_MODULES_PATH) LINUXINCLUDE=$(LINUXINCLUDE))
$(info KO_HYPER_CODE_PATH=$(KO_HYPER_CODE_PATH))
$(info KO_HYPER_INCLUDE_PATH=$(KO_HYPER_INCLUDE_PATH))

subdir-ccflags-y += -I$(KO_HYPER_CODE_PATH)/ -I$(KO_HYPER_INCLUDE_PATH)/

obj-y += guest_memory/
obj-y += acrn/
obj-y += acrn_nbl/
obj-y += vhost/
obj-y += vhost_dmabuf/
obj-y += nebula_rproc/
obj-y += rproc_net/
obj-y += virtio_net/
obj-y += af_vsockx/
obj-y += nebula_rtc/
obj-y += nebula_debug_tool/
obj-y += af_vsock/
obj-y += vhost_vsock/
obj-y += vhost_alloc/
obj-y += virtio_rpmsg_bus/
